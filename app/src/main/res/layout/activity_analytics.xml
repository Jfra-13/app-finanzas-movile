<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray">

    <!-- Scrollable content. Drawn FIRST so the fixed top bar (declared last) can
         float over it — content scrolls beneath the frosted bar. Top padding is
         set at runtime to the bar's height (status-bar inset included). -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="120dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingTop="8dp">

            <!-- Weekly bar chart card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardWeekly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen semanal"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_black_soft"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ingresos vs egresos por día"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"
                        android:layout_marginBottom="16dp" />

                    <com.github.mikephil.charting.charts.BarChart
                        android:id="@+id/barChartWeekly"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tvWeeklyEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:gravity="center"
                        android:text="Sin movimientos esta semana"
                        android:textColor="@color/text_gray"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Monthly trend line chart card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMonthly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tendencia mensual"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_black_soft"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Evolución de ingresos y egresos"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggleMeses"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:singleSelection="true"
                        app:selectionRequired="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMeses3"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="3M"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMeses6"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="6M"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnMeses12"
                            style="?attr/materialButtonOutlinedStyle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="12M"
                            android:textSize="12sp" />

                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChartMonthly"
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tvMonthlyEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:gravity="center"
                        android:text="Sin datos de tendencia mensual"
                        android:textColor="@color/text_gray"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category pie chart card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Egresos por categoría"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_black_soft"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Distribución del mes actual"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"
                        android:layout_marginBottom="16dp" />

                    <com.github.mikephil.charting.charts.PieChart
                        android:id="@+id/pieChartCategories"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/tvCategoriesEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:gravity="center"
                        android:text="Sin egresos registrados este mes"
                        android:textColor="@color/text_gray"
                        android:textSize="14sp"
                        android:visibility="gone" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Financial health panel -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHealth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="?attr/colorSurface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Salud financiera"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_black_soft"
                        android:layout_marginBottom="12dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvHealthSignals"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone" />

                    <!-- Celebratory "all good" state — the Peak-End reward moment.
                         The emoji pulses (ObjectAnimator wired in the Activity). -->
                    <LinearLayout
                        android:id="@+id/healthCelebration"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingVertical="20dp"
                        android:visibility="visible">

                        <FrameLayout
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:layout_marginBottom="12dp">

                            <!-- Soft glow behind the badge -->
                            <View
                                android:id="@+id/healthGlow"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_health_glow" />

                            <TextView
                                android:id="@+id/tvHealthEmoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="🎉"
                                android:textSize="44sp" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvHealthCelebrationTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="¡Todo va sobre ruedas!"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@color/success"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="Tus finanzas están en orden. Seguí así 💪"
                            android:textSize="13sp"
                            android:textColor="@color/text_gray" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Universal state overlay (loading / empty / error). Padded below the bar at runtime. -->
    <include
        android:id="@+id/viewState"
        layout="@layout/view_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Fixed top bar. Declared LAST so it floats over the scrolling content; its
         background is alpha-animated on scroll (frosted scrim — the View system has
         no real backdrop blur). Status-bar inset is pushed into paddingTop at runtime. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:background="@color/bg_gray">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/back_arrow"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Volver"
            android:padding="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Analíticas"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_black_soft" />

    </LinearLayout>

    <include layout="@layout/layout_bottom_navigation" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
