<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardDineroAcumulado"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:shapeAppearance="@style/ShapeAppearance.App.MediumComponent"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvDineroAcumuladoTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="Dinero acumulado"
            android:textColor="?attr/colorPrimary"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:layout_width="109dp"
            android:layout_height="17dp"
            android:layout_marginEnd="8dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="@id/tvDineroAcumuladoTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.529">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Objetivo: "
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvDineroObjetivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7000"
                android:textColor="?attr/colorPrimary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Soles"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llMontoAcumulado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="2dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDineroAcumuladoTitle">

            <TextView
                android:id="@+id/tvDineroTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1750"
                android:textColor="?attr/colorPrimary"
                android:textSize="40sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.6"
                android:paddingBottom="4dp"
                android:text=" Soles"
                android:textColor="?attr/colorOnSurface"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llChartBars"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="7"
            app:layout_constraintTop_toBottomOf="@id/llMontoAcumulado">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/barEgresoLu"
                        android:layout_width="12dp"
                        android:layout_height="140dp"
                        android:background="@drawable/bg_bar_grey" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="wrap_content" />

                    <View
                        android:id="@+id/barIngresoLu"
                        android:layout_width="12dp"
                        android:layout_height="200dp"
                        android:background="@drawable/bg_bar_blue" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Lu"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/barEgresoMar"
                        android:layout_width="12dp"
                        android:layout_height="90dp"
                        android:background="@drawable/bg_bar_grey" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="wrap_content" />

                    <View
                        android:id="@+id/barIngresoMar"
                        android:layout_width="12dp"
                        android:layout_height="160dp"
                        android:background="@drawable/bg_bar_blue" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Mar"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/barEgresoMie"
                        android:layout_width="12dp"
                        android:layout_height="120dp"
                        android:background="@drawable/bg_bar_grey" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="wrap_content" />

                    <View
                        android:id="@+id/barIngresoMie"
                        android:layout_width="12dp"
                        android:layout_height="190dp"
                        android:background="@drawable/bg_bar_blue" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Mie"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/barEgresoJue"
                        android:layout_width="12dp"
                        android:layout_height="170dp"
                        android:background="@drawable/bg_bar_grey" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="wrap_content" />

                    <View
                        android:id="@+id/barIngresoJue"
                        android:layout_width="12dp"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_bar_blue" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Jue"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/barEgresoVie"
                        android:layout_width="12dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_bar_grey" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="wrap_content" />

                    <View
                        android:id="@+id/barIngresoVie"
                        android:layout_width="12dp"
                        android:layout_height="150dp"
                        android:background="@drawable/bg_bar_blue" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Vie"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/barEgresoSab"
                        android:layout_width="12dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_bar_grey" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="wrap_content" />

                    <View
                        android:id="@+id/barIngresoSab"
                        android:layout_width="12dp"
                        android:layout_height="110dp"
                        android:background="@drawable/bg_bar_blue" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Sab"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/barEgresoDom"
                        android:layout_width="12dp"
                        android:layout_height="130dp"
                        android:background="@drawable/bg_bar_grey" />

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="wrap_content" />

                    <View
                        android:id="@+id/barIngresoDom"
                        android:layout_width="12dp"
                        android:layout_height="100dp"
                        android:background="@drawable/bg_bar_blue" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Dom"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>