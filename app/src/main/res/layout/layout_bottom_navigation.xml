<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Floating pill nav — theme tokens so it adapts to dark mode. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomNavCard"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="?attr/colorSurface"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:id="@+id/navItemsRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="12dp"
                android:contentDescription="@string/nav_home"
                android:src="@drawable/ic_home"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/navCalendar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="16dp"
                android:contentDescription="@string/nav_calendar"
                android:src="@drawable/ic_calendar"
                app:tint="?attr/colorOnSurfaceVariant" />

            <!-- Spacer under the floating FAB so the docked button never overlaps an icon. -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2" />

            <ImageView
                android:id="@+id/navStats"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="16dp"
                android:contentDescription="@string/nav_stats"
                android:src="@drawable/ic_stats"
                app:tint="?attr/colorOnSurfaceVariant" />

            <ImageView
                android:id="@+id/navUser"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="16dp"
                android:contentDescription="@string/nav_profile"
                android:src="@drawable/ic_user"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Docked FAB. Anchored to the pill's top-center edge so it straddles it; its
         own elevation shadow lifts it off the bar — no opaque cradle behind it. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardFabAdd"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:translationY="14dp"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/fab_add"
        app:cardBackgroundColor="?attr/colorPrimary"
        app:cardCornerRadius="34dp"
        app:cardElevation="16dp"
        app:strokeWidth="0dp"
        app:layout_anchor="@id/bottomNavCard"
        app:layout_anchorGravity="top|center">

        <ImageView
            android:id="@+id/ivFabIcon"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_add"
            app:tint="?attr/colorOnPrimary" />
    </com.google.android.material.card.MaterialCardView>

</merge>
