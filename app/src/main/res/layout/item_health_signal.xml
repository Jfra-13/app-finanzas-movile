<?xml version="1.0" encoding="utf-8"?>
<!-- Financial-health signal row. Severity-driven: card background, left accent bar
     and icon disc are tinted at runtime; all colours come from theme-aware resources
     (see values/ + values-night/) so it holds up in dark mode. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/health_info_bg"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <View
            android:id="@+id/healthAccent"
            android:layout_width="4dp"
            android:layout_height="42dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_health_accent" />

        <FrameLayout
            android:id="@+id/healthIconCircle"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_oval_solid">

            <TextView
                android:id="@+id/tvHealthIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="18sp"
                android:text="ℹ️"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvHealthMensaje"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/on_surface"
            android:text="Mensaje de salud financiera" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
