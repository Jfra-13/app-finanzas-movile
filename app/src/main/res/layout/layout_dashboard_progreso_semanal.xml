<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardProgresoSemanal"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    app:cardBackgroundColor="?attr/colorPrimary"
    app:shapeAppearance="@style/ShapeAppearance.App.MediumComponent"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <LinearLayout
            android:id="@+id/llSemanalStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/ivSemanalIcon"
                android:layout_width="23dp"
                android:layout_height="23dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_power_full_w" />
            <TextView
                android:id="@+id/tvSemanalStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Excelente"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="21sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSemanalTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:text="Tu progreso\nsemanal"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="25sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/flSemanalChart"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/llSemanalStatus" />

        <FrameLayout
            android:id="@+id/flSemanalChart"
            android:layout_width="128dp" android:layout_height="128dp" android:layout_marginEnd="16dp" app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.example.finanzas_independientes_app.presentation.common.CircularProgressView
                android:id="@+id/pbProgresoSemanal"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/tvSemanalPorcentaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="100%"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="28sp" android:textStyle="bold" />
        </FrameLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>