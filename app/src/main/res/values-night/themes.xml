<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Dark mode: semantic @color/* names resolve to dark values via values-night/colors.xml.
      We mirror the same attrs; no need to hardcode hex — the color file handles the flip.
    -->
    <style name="Base.Theme.Finanzas_independientes_app" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/blue_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorError">@color/error_red</item>
        <item name="colorOutline">@color/outline</item>
    </style>
</resources>