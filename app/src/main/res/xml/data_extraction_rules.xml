<?xml version="1.0" encoding="utf-8"?>
<!--
    API 31+. android:allowBackup="false" already blocks cloud backup, but it
    does NOT block device-to-device transfer, so both paths are excluded here.

    Two reasons for the exclusions:
    - Privacy: finanzas.db holds the user's transactions in plain SQLite.
    - Correctness: the session tokens live in EncryptedSharedPreferences whose
      master key stays in the Android Keystore and is never transferred. A
      restored prefs file would be undecryptable and fail on first read.

    Nothing is lost on a new device: everything is re-fetched after login.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
