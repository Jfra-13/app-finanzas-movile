<?xml version="1.0" encoding="utf-8"?>
<!--
    API 30 and below. Redundant while android:allowBackup="false", kept so the
    exclusions survive if backup is ever re-enabled. See data_extraction_rules
    for why the session prefs and the database must never leave the device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
